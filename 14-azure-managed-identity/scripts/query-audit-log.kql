// =============================================================================
// query-audit-log.kql
// Description: KQL queries for Log Analytics -- captures Key Vault SecretGet
//              audit events generated by the managed identity.
//
// Run in: Azure Portal -> Log Analytics workspace -> Logs
//
// Author: Cleveland Oliver | IDSentinel Solutions
// Scenario: 14 -- Securing Non-Human Identities: Azure Managed Identity
// =============================================================================

// Query 1 -- All successful secret retrievals (last 24 hours)
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where ResourceType == "VAULTS"
| where OperationName == "SecretGet"
| where ResultType == "Success"
| project
    TimeGenerated,
    CallerIPAddress,
    identity_claim_oid_g,
    OperationName,
    ResultType,
    requestUri_s,
    Resource
| order by TimeGenerated desc
| take 20


// Query 2 -- All operations by the managed identity (replace OID below)
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where ResourceType == "VAULTS"
| where identity_claim_oid_g == "<PASTE_MANAGED_IDENTITY_PRINCIPAL_ID_HERE>"
| project
    TimeGenerated,
    OperationName,
    ResultType,
    requestUri_s,
    CallerIPAddress
| order by TimeGenerated desc


// Query 3 -- Denied operations (least-privilege enforcement evidence)
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where ResourceType == "VAULTS"
| where ResultType == "Forbidden"
| project
    TimeGenerated,
    CallerIPAddress,
    identity_claim_oid_g,
    OperationName,
    ResultSignature,
    requestUri_s
| order by TimeGenerated desc
