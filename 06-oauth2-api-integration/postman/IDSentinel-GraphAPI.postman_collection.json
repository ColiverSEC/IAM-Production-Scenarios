  "item": [
    {
      "name": "01 - Get Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "pm.collectionVariables.set(\"accessToken\", jsonData.access_token);\r",
              "pm.test(\"Token received successfully\", function() {\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.expect(jsonData.token_type).to.equal(\"Bearer\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
