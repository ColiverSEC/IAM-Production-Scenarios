          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://graph.microsoft.com/v1.0/users?$filter=userType eq 'Guest'&$select=displayName,userPrincipalName,createdDateTime,signInActivity",
          "protocol": "https",
          "host": [
