{
  "info": {
    "name": "IDSentinel â€” Scenario 08 CIAM B2C",
    "_postman_id": "placeholder",
    "description": "Azure AD B2C OAuth2 flows â€” Scenario 08\nReplace variable values with your B2C tenant details.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "tenant_name",   "value": "your-tenant.onmicrosoft.com" },
    { "key": "client_id",     "value": "your-app-client-id" },
    { "key": "client_secret", "value": "your-client-secret" },
    { "key": "policy",        "value": "B2C_1_SignUpSignIn" },
    { "key": "redirect_uri",  "value": "https://jwt.ms" },
    { "key": "access_token",  "value": "" }
  ],
  "item": [
    {
      "name": "1 â€” Get Authorization Code (browser step)",
      "request": {
        "method": "GET",
        "description": "Open this URL in a browser to complete interactive login and capture the code= parameter from the redirect.",
        "url": {
          "raw": "https://{{tenant_name}}.b2clogin.com/{{tenant_name}}/{{policy}}/oauth2/v2.0/authorize?client_id={{client_id}}&response_type=code&redirect_uri={{redirect_uri}}&scope=openid+profile+email+offline_access&response_mode=query",
          "host": ["{{tenant_name}}.b2clogin.com"],
          "path": ["{{tenant_name}}", "{{policy}}", "oauth2", "v2.0", "authorize"]
        }
      }
    },
    {
      "name": "2 â€” Exchange Code for Tokens",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type",    "value": "authorization_code" },
            { "key": "client_id",     "value": "{{client_id}}" },
            { "key": "client_secret", "value": "{{client_secret}}" },
            { "key": "code",          "value": "PASTE_AUTH_CODE_HERE" },
            { "key": "redirect_uri",  "value": "{{redirect_uri}}" },
            { "key": "scope",         "value": "openid profile email offline_access" }
          ]
        },
        "url": {
          "raw": "https://{{tenant_name}}.b2clogin.com/{{tenant_name}}/{{policy}}/oauth2/v2.0/token",
          "host": ["{{tenant_name}}.b2clogin.com"],
          "path": ["{{tenant_name}}", "{{policy}}", "oauth2", "v2.0", "token"]
        }
      }
    },
    {
      "name": "3 â€” Call Protected API with Bearer Token",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": {
          "raw": "https://your-api-endpoint.example.com/api/resource",
          "host": ["your-api-endpoint.example.com"],
          "path": ["api", "resource"]
        }
      }
    }
  ]
}
